    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->
    


    <!-- https://purl.org/oquo#OquareCategory1 -->

    <owl:NamedIndividual rdf:about="https://purl.org/oquo#OquareCategory1">
        <rdf:type rdf:resource="https://purl.org/oquo#OquareFiveCategoriesCategory"/>
        <om-1:rank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</om-1:rank>
        <obo:IAO_0000115>Not acceptable</obo:IAO_0000115>
        <rdfs:label>oquare category 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://purl.org/oquo#OquareCategory2 -->

    <owl:NamedIndividual rdf:about="https://purl.org/oquo#OquareCategory2">
        <rdf:type rdf:resource="https://purl.org/oquo#OquareFiveCategoriesCategory"/>
        <om-1:rank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</om-1:rank>
        <obo:IAO_0000115>Insufficient</obo:IAO_0000115>
        <rdfs:label>oquare category 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://purl.org/oquo#OquareCategory3 -->

    <owl:NamedIndividual rdf:about="https://purl.org/oquo#OquareCategory3">
        <rdf:type rdf:resource="https://purl.org/oquo#OquareFiveCategoriesCategory"/>
        <om-1:rank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</om-1:rank>
        <obo:IAO_0000115>Minimally acceptable</obo:IAO_0000115>
        <rdfs:label>oquare category 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://purl.org/oquo#OquareCategory4 -->

    <owl:NamedIndividual rdf:about="https://purl.org/oquo#OquareCategory4">
        <rdf:type rdf:resource="https://purl.org/oquo#OquareFiveCategoriesCategory"/>
        <om-1:rank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</om-1:rank>
        <obo:IAO_0000115>Acceptable</obo:IAO_0000115>
        <rdfs:label>oquare category 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://purl.org/oquo#OquareCategory5 -->

    <owl:NamedIndividual rdf:about="https://purl.org/oquo#OquareCategory5">
        <rdf:type rdf:resource="https://purl.org/oquo#OquareFiveCategoriesCategory"/>
        <om-1:rank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</om-1:rank>
        <obo:IAO_0000115>Exceeds the requirements</obo:IAO_0000115>
        <rdfs:label>oquare category 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://purl.org/oquo#OquareFiveCategoriesScale -->

    <owl:NamedIndividual rdf:about="https://purl.org/oquo#OquareFiveCategoriesScale">
        <rdf:type rdf:resource="http://www.wurvoc.org/vocabularies/om-1.8/Ordinal_scale"/>
        <QualityModel:hasRankigFunction rdf:resource="http://purl.org/net/QualityModel#HigherBest"/>
        <om-1:element rdf:resource="https://purl.org/oquo#OquareCategory1"/>
        <om-1:element rdf:resource="https://purl.org/oquo#OquareCategory2"/>
        <om-1:element rdf:resource="https://purl.org/oquo#OquareCategory3"/>
        <om-1:element rdf:resource="https://purl.org/oquo#OquareCategory4"/>
        <om-1:element rdf:resource="https://purl.org/oquo#OquareCategory5"/>
        <obo:IAO_0000115>Scale used by OQuaRE, consisting in five categories from 1 to 5, meaning not acceptable, insufficient, minimally acceptable, acceptable, and exceeds requirements, respectively.</obo:IAO_0000115>
        <rdfs:label>oquare five categories scale</rdfs:label>
    </owl:NamedIndividual>
    


